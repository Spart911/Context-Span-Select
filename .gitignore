# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env
.env.*
!.env.example

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.DS_Store

# Local secrets / tokens
*.pem
credentials.json
hf_token*

# Heavy data (keep structure via .gitkeep)
data/raw/**
!data/raw/.gitkeep
!data/raw/README.md
data/processed/**
!data/processed/.gitkeep
!data/processed/README.md
data/cache/**
!data/cache/.gitkeep

# Experiment artifacts
results/runs/**
!results/runs/.gitkeep
results/tables/**
!results/tables/.gitkeep
results/figures/**
!results/figures/.gitkeep
!results/README.md

# Model weights / local checkpoints
artifacts/models/**
!artifacts/models/.gitkeep
*.safetensors
*.gguf
*.bin
*.pt
*.ckpt

# Logs
logs/**
!logs/.gitkeep
*.log
